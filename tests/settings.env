APP_NAME='aeko-hub'
TIMESTAMP_FORMAT='%Y-%m-%dT%H:%M:%SZ'
BLUE='"\\u001b[34m"'
RED='"\\u001b[31m"'
RESET='"\\u001b[0m"'
TRUE_VALUES='["1", "on", "true", "yes"]'
FALSE_VALUES='["0", "false", "no", "off"]'
CRASHED_STATUS='500'
UNKNOWN_ENDPOINT='?'
REQUEST_ID_HEADER='x-request-id'
UVICORN_ACCESS_LOGGER='uvicorn.access'
INDENT='    '
FAILING_STATUS='400'
CALCULATOR_MAX_EXPRESSION_LENGTH='500'
CALCULATOR_MAX_EXPONENT='1000'
CALCULATOR_DECIMAL_PLACES='10'
CALCULATOR_MAX_EXACT_INTEGER='9007199254740992'
CALCULATOR_DESCRIPTION='Calculates an arithmetic expression exactly. Use it for every number you report — totals, emission factors applied to activity data, unit conversions, percentages and differences — instead of working the arithmetic out yourself. Input is the expression alone, as text, with no words around it: for example \'(1200 * 2.68) / 1000\'. It understands numbers, the operators + - * / // % ** and parentheses, and these functions: abs, log, max, min, round, sqrt, sum (for example \'round(sum([120.5, 340.2, 78.9]), 2)\'). It answers with the number alone. It has no variables and no units, so substitute the values yourself and keep track of the unit.'
ROI_HORIZON_MONTHS='60'
ROI_PAYBACK_NOT_RECOVERED='-1'
ROI_DECIMAL_PLACES='2'
ROI_MAX_WACC_MONTHLY='1'
ROI_REQUEST_DESCRIPTION='Input is a JSON object string with "capex" (the initial investment, above zero), "wacc_monthly" (the monthly discount rate as a decimal, so 0.01 is 1% a month — convert an annual rate before sending it) and exactly one of "monthly_cash_flow" (one net monthly cash flow, repeated over the {ROI_HORIZON_MONTHS} months) or "cash_flows" (the monthly flows in order, up to {ROI_HORIZON_MONTHS} of them, months left out counting as zero; a month that costs money is negative) — for example \'{"capex": 150000, "wacc_monthly": 0.01, "monthly_cash_flow": 5000}\'. Each flow is discounted to its present value over a fixed {ROI_HORIZON_MONTHS}-month horizon.'
ROI_DESCRIPTION='Calculates the return on investment (ROI) of an improvement project. {ROI_REQUEST_DESCRIPTION} Answers "vp_total" (the present value of all the flows), "vpl" (that minus the capex), "roi_percent" and "viable" (true when the capex is at most the present value). Use it to decide whether a proposal is worth making and to rank proposals against each other.'
PAYBACK_DESCRIPTION='Calculates the payback of an improvement project: the first month in which the discounted cash flows accumulated so far have paid the capex back. {ROI_REQUEST_DESCRIPTION} Answers "payback_months", which is {ROI_PAYBACK_NOT_RECOVERED} when the capex is not recovered within the {ROI_HORIZON_MONTHS} months, together with "vp_total" and "viable". Use it to say how long the company waits, which is a different question from whether the project pays — calculate_roi answers that one.'
GET_IMPROVEMENT_PLAN_BY_INVENTORY_DESCRIPTION='Return the improvement plan for one inventory, including the defined problem, method, reasoning, and update time. Pass id_external_inventory as a positive integer such as 502.'
GET_IMPROVEMENT_PLAN_PROBLEM_DESCRIPTION='Return only the defined problem of an inventory\'s improvement plan. Pass id_external_inventory as a positive integer such as 502.'
GET_IMPROVEMENT_PLAN_METHOD_DESCRIPTION='Return only the method of an inventory\'s improvement plan. Pass id_external_inventory as a positive integer such as 502.'
GET_IMPROVEMENT_PLAN_REASONING_DESCRIPTION='Return only the reasoning of an inventory\'s improvement plan. Pass id_external_inventory as a positive integer such as 502.'
LIST_LATEST_IMPROVEMENT_PLANS_DESCRIPTION='List the most recently updated improvement plans for the user\'s company. Pass id_external_user as a positive integer such as 12345 and n as a positive integer such as 3 for how many of that company\'s newest plans to return.'
GET_USER_PROFILE_BY_EXTERNAL_ID_DESCRIPTION='Return the role and usecase for one user. Pass id_external_user as a positive integer such as 12345.'
UPDATE_USER_PROFILE_DESCRIPTION='Update role and/or usecase for an existing user. Pass id_external_user as a positive integer such as 12345 and at least one of role or usecase as a nonempty string.'
LIST_USER_MEMORY_FIELDS_DESCRIPTION='List the memory field names stored for one user. Pass id_external_user as a positive integer such as 12345.'
GET_USER_MEMORY_BY_FIELD_DESCRIPTION='Return one memory\'s field and description for a user. Pass id_external_user as a positive integer such as 12345 and field as a nonempty name such as "preferred_language".'
LIST_USER_MEMORIES_DESCRIPTION='List every memory field and description for one user. Pass id_external_user as a positive integer such as 12345.'
LIST_USER_SESSION_NAMES_DESCRIPTION='List conversation session names for one user, without messages. Pass id_external_user as a positive integer such as 12345.'
GET_SESSION_MESSAGES_BY_NAME_DESCRIPTION='Return the messages of one named conversation session for a user. Pass id_external_user as a positive integer such as 12345 and session_name as a nonempty name such as "Weekly emissions review".'
GET_LATEST_SESSION_MESSAGES_DESCRIPTION='Return the newest messages of one named conversation session. Pass id_external_user as a positive integer such as 12345, session_name as a nonempty name such as "Weekly emissions review", and n as a positive integer such as 5.'
COUNT_USER_SESSIONS_DESCRIPTION='Count conversation sessions belonging to one user. Pass id_external_user as a positive integer such as 12345.'
ANALYZE_INVENTORY_DESCRIPTION='Submit an inventory spreadsheet or image for analysis in two calls. First call: send id_external_user, name, fileName and fileType (IMAGE or XLSX); it returns a ticket. The file upload continues in the Aether app, so tell the user to upload the file there. Second call: send only id_external_user and ticket once the user has uploaded the file; the inventory is then created. After it is created, tell the user to check the result later with get_inventory_analysis.'
CHATGPT_ANALYZE_INVENTORY_DESCRIPTION='Submit an inventory spreadsheet or image for analysis. Pass name, fileType (IMAGE or XLSX), and the hosted file. After it is created, tell the user to check the result later with get_inventory_analysis.'
GET_INVENTORY_ANALYSIS_DESCRIPTION='Poll the analysis of an inventory this user created through analyze_inventory. Pass the inventory id. A PROCESSING status means the analysis is not ready yet; try again later.'
ASK_AEKO_DESCRIPTION='Send a question to Aeko for the user identified by id_external_user. Optionally pass session_name to continue a named conversation session.'
DEFAULT_STARTUP_TIMEOUT='300.0'
DEFAULT_CALL_TIMEOUT='120.0'
DEFAULT_CLOSE_TIMEOUT='30.0'
QUERY_GASES_INFO_TOOL_NAME='query_gases_info'
CHROMA_MCP_SERVER_SCRIPT='chroma_mcp_server.py'
PASSTHROUGH_ENV_VARS='["PATH", "HOME", "USERPROFILE", "SYSTEMROOT", "HF_HOME", "TRANSFORMERS_CACHE", "SENTENCE_TRANSFORMERS_HOME", "DEFAULT_STARTUP_TIMEOUT", "DEFAULT_CALL_TIMEOUT", "DEFAULT_CLOSE_TIMEOUT", "QUERY_GASES_INFO_TOOL_NAME", "CHROMA_MCP_SERVER_SCRIPT", "PASSTHROUGH_ENV_VARS", "QUIET_CHILD_ENV", "QUERY_GASES_INFO_DESCRIPTION", "GASES_INFO_COLLECTION", "IMPROVEMENT_PLAN_PROBLEMS_COLLECTION", "QUERY_IMPROVEMENT_PLAN_PROBLEMS_TOOL_NAME", "QUERY_IMPROVEMENT_PLAN_PROBLEMS_DESCRIPTION", "EMBEDDING_MODEL", "DEFAULT_RESULT_COUNT", "QUERY_INCLUDE", "TAVILY_SEARCH_DESCRIPTION", "TAVILY_RESEARCH_DESCRIPTION", "TAVILY_MAP_DESCRIPTION"]'
QUIET_CHILD_ENV='{"TQDM_DISABLE": "1", "HF_HUB_DISABLE_PROGRESS_BARS": "1"}'
QUERY_GASES_INFO_DESCRIPTION='Searches the Aether greenhouse-gas knowledge base by meaning, not by keyword, to find information such as possible substitutions for a gas. Input is the question or topic to look up, in plain text (e.g. \'what can replace SF6 in switchgear\'). Read-only; always scoped to the gases-info collection.'
GASES_INFO_COLLECTION='gases-info'
IMPROVEMENT_PLAN_PROBLEMS_COLLECTION='improvement-plan-problems'
QUERY_IMPROVEMENT_PLAN_PROBLEMS_TOOL_NAME='query_improvement_plan_problems'
QUERY_IMPROVEMENT_PLAN_PROBLEMS_DESCRIPTION='Search improvement plans by the meaning of the defined problem, not by keyword. Pass id_external_user as a positive integer such as 12345 and query as nonempty text such as "flaring". Returns matching plans the user company may see.'
EMBEDDING_MODEL='paraphrase-multilingual-mpnet-base-v2'
DEFAULT_RESULT_COUNT='5'
QUERY_INCLUDE='["documents", "metadatas", "distances"]'
TAVILY_SEARCH_DESCRIPTION='Searches the web via Tavily for current information the agent\'s own knowledge does not cover. Input is a search query string.'
TAVILY_RESEARCH_DESCRIPTION='Runs a deeper Tavily research pass over a topic, gathering more context than a plain search. Input is a research query string.'
TAVILY_MAP_DESCRIPTION='Maps the Aether website\'s structure via Tavily to help answer FAQ questions about it. Takes no meaningful input; the site is fixed.'
REDIS_URI='redis://localhost:6379/0'

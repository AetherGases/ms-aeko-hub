GEMINI_API_KEY=
AEKO_FAST_MODEL=
AEKO_SLOW_MODEL=
AEKO_MAX_TOKENS=
AEKO_REPORT_MAX_TOKENS=
# JSON map of model name to USD per million tokens: {"gemini-3.5-flash": {"input_per_million": 0.15, "output_per_million": 0.60}}.
# Environment rates are more effective than hardcoded prices because they allow campaigns with custom pricing.
AEKO_MODEL_PRICES=

TAVILY_API_KEY=
# Public Aether website used by tavily_map.
AETHER_WEB_SITE_URL=https://aethergases.org/

AEKO_MCP_WARM_UP=true

CHROMA_TENANT=
CHROMA_DATABASE=aeko-gases-vector-store
CHROMA_API_KEY=

CLIMATIQ_API_KEY=

CLOUDINARY_MS_BASE_URL=
INVENTORY_MS_BASE_URL=
INVESTMENT_MS_BASE_URL=
INVENTORY_MS_API_KEY=
# Shared secret for internal service calls (authentication-key header).
INTERNAL_AUTHENTICATION_KEY=
AUTH_MS_BASE_URL=
MS_HTTP_TIMEOUT=
CHATGPT_FILE_MAX_BYTES=
CHATGPT_FILE_ALLOWED_HOSTS=files.oaiusercontent.com
INVENTORY_UPLOAD_TICKET_TTL_SECONDS=

OAUTH_SIGNING_KEY=
# Public base URL (include Kong path prefix, e.g. https://aethergases.org/hub)
OAUTH_ISSUER=
# Exact public MCP URL (trailing slash), e.g. https://aethergases.org/hub/ai/mcp/
OAUTH_AUDIENCE=
OAUTH_CLIENT_ID=
OAUTH_AUTHORIZATION_CODE_TTL_SECONDS=
OAUTH_ACCESS_TOKEN_TTL_SECONDS=
# 32-byte AES-GCM key as 64 hex characters. Do not reuse OAUTH_SIGNING_KEY.
OAUTH_SESSION_ENCRYPTION_KEY=
# Email Sign-in cap in this API. IP cap is Kong on POST /hub/ai/oauth/authorize.
OAUTH_AUTHORIZE_RATE_LIMIT_MAX=5
OAUTH_AUTHORIZE_RATE_LIMIT_WINDOW_SECONDS=900

APP_NAME=

# OpenTelemetry metrics export (Dynatrace OTLP). Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to disable export.
# Example endpoint for tenant xiw68385: https://xiw68385.live.dynatrace.com/api/v2/otlp/v1/metrics
# Platform token (dtwiz): Authorization=Bearer <token> — scope openpipeline:metrics:ingest
# Classic access token only: Authorization=Api-Token <token> — scope metrics.ingest
OTEL_SERVICE_NAME=aeko-hub
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=DELTA
OTEL_METRIC_EXPORT_INTERVAL_MS=60000
